# Default backend the PWA talks to. On office LAN this points at the local
# Spring Boot instance; a Boss connecting from outside would use the Settings
# screen override instead of a rebuild (see src/lib/api-client.ts).
VITE_API_BASE_URL=http://localhost:8080/api

# ── Tunables ────────────────────────────────────────────────────────────────
# Read by src/constants/env.ts. Every value is optional: a missing or invalid
# one falls back to the default shown here. Vite inlines them at build time,
# so restart `npm run dev` / rebuild after changing any of them.

# App identity
VITE_APP_NAME=Kabos
VITE_APP_FULL_NAME=Cocoa Management System
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_CURRENCY=XAF

# Minimum time (ms) a page shows its loading skeleton. 0 = only while loading.
VITE_SKELETON_DURATION_MS=5000

# Page sizes
VITE_PAGE_SIZE=20
VITE_PAGE_SIZE_OPTIONS=10,20,50
VITE_AUDIT_PAGE_SIZE=10
VITE_LOOKUP_PAGE_SIZE=100
VITE_WAREHOUSE_PAGE_SIZE=50
VITE_PLATFORM_SUBSCRIPTIONS_PAGE_SIZE=50
VITE_PAYROLL_HISTORY_PAGE_SIZE=5
VITE_PAYSLIP_HISTORY_SIZE=200

# Dashboards
VITE_ADMIN_DASHBOARD_PAGE_SIZE=8
VITE_DASHBOARD_LIST_SIZE=50
VITE_DASHBOARD_MOVEMENT_SIZE=8
VITE_DASHBOARD_PRICE_HISTORY_SIZE=14
VITE_DASHBOARD_EMPLOYEE_SIZE=200
VITE_DASHBOARD_CARD_PAGE_SIZE=4

# Query cache (ms) and retries
VITE_QUERY_STALE_MS=30000
VITE_QUERY_GC_MS=300000
VITE_QUERY_RETRY_COUNT=2
VITE_SESSION_STALE_MS=300000
VITE_SUBSCRIPTION_STALE_MS=60000
VITE_PLANS_STALE_MS=900000
VITE_WAREHOUSES_STALE_MS=300000
VITE_EXPENSE_CATEGORIES_STALE_MS=600000
VITE_CURRENT_PRICE_STALE_MS=60000

# Notifications & session (ms)
VITE_TOAST_SUCCESS_DURATION_MS=3500
VITE_TOAST_ERROR_DURATION_MS=7000
VITE_TOKEN_EXPIRY_SKEW_MS=30000
