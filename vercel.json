{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/keuka/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/keuka/:path*", "destination": "/keuka/index.html" }
  ],
  "headers": [
    {
      "source": "/keuka/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
